# ---- WC2026 Pick'em тохиргоо ----

# Чиний MongoDB холболтын string.
# MongoDB Atlas жишээ:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wc2026pickem?retryWrites=true&w=majority
# Local MongoDB жишээ:
#   mongodb://127.0.0.1:27017/wc2026pickem
# ХООСОН орхивол хөгжүүлэлтэд зориулж санах ойн (in-memory) MongoDB автоматаар асна (өгөгдөл хадгалагдахгүй).
MONGODB_URI=

# Сервер ажиллах порт
PORT=3000

# Admin түлхүүр — энэ түлхүүртэй хүн л групп бүрийн ЖИНХЭНЭ эцсийн байрыг оруулж чадна (оноо тооцоход).
# Урт, тааварлахад хэцүү утга өг.
ADMIN_KEY=change-me-to-a-long-secret

# (Заавал биш) Таамаг оруулах эцсийн хугацаа. ISO формат, ж: 2026-06-11T16:00:00Z
# Энэ хугацааны дараа хэн ч таамгаа өөрчилж чадахгүй. Хоосон бол хязгаар тавихгүй.
PICKS_LOCK_AT=
